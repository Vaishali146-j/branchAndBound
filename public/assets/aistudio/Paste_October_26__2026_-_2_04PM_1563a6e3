import { useRef, useState } from "react";
import { createTspSolver } from "./tspBranchBound";

const cities = ["A", "B", "C", "D"];

const distances = [
  [0, 10, 15, 20],
  [10, 0, 35, 25],
  [15, 35, 0, 30],
  [20, 25, 30, 0],
];

export default function TspVisualizer() {
  const solverRef = useRef(createTspSolver(distances, 0));
  const [view, setView] = useState(() =>
    solverRef.current.getState()
  );
  const [history, setHistory] = useState([]);

  function handleNextStep() {
    setHistory((previous) => [...previous, view]);
    setView(solverRef.current.nextStep());
  }

  function handleReset() {
    solverRef.current = createTspSolver(distances, 0);
    setHistory([]);
    setView(solverRef.current.getState());
  }

  const currentNode = view.nodes.find(
    (node) => node.id === view.currentNodeId
  );

  return (
    <main className="visualizer">
      <h1>TSP Branch & Bound Explorer</h1>

      <section className="controls">
        <button
          onClick={handleNextStep}
          disabled={view.type === "finished"}
        >
          Next Step
        </button>

        <button onClick={handleReset}>
          Reset
        </button>

        <span>Expanded: {view.stats.expanded}</span>
        <span>Pruned: {view.stats.pruned}</span>
        <span>Generated: {view.stats.generated}</span>
      </section>

      <section className="panel">
        <h2>Algorithm Explanation</h2>
        <h3>{view.title}</h3>
        <p>{view.explanation}</p>
      </section>

      <section className="panel">
        <h2>Best Tour Found</h2>
        {view.bestTour ? (
          <p>
            {view.bestTour.map((city) => cities[city]).join(" → ")}
            {" "} — Cost: {view.bestCost}
          </p>
        ) : (
          <p>No complete tour found yet.</p>
        )}
      </section>

      <section className="panel">
        <h2>Search Tree Nodes</h2>
        {view.nodes.map((node) => (
          <div className="tree-node" key={node.id}>
            <strong>Node {node.id}</strong>
            {" · "}
            {node.path.map((city) => cities[city]).join(" → ")}
            {" · Bound: "}
            {Number.isFinite(node.bound) ? node.bound : "∞"}
            {" · "}
            <span>{node.status}</span>
            {node.reason && <p>{node.reason}</p>}
          </div>
        ))}
      </section>

      <section className="panel">
        <h2>Child Decisions</h2>
        {view.childEvents?.map((child) => (
          <div key={child.nodeId ?? child.city}>
            <strong>
              {cities[currentNode?.path.at(-1) ?? 0]}
              {" → "}
              {cities[child.city]}
            </strong>
            {" · "}
            {child.status}
            {child.bound !== undefined && (
              <> · Lower bound: {child.bound}</>
            )}
            {child.cost !== undefined && (
              <> · Tour cost: {child.cost}</>
            )}
            <p>{child.reason}</p>
          </div>
        ))}
      </section>

      <section className="panel">
        <h2>Current Reduced Cost Matrix</h2>
        {currentNode?.matrix ? (
          <MatrixView matrix={currentNode.matrix} />
        ) : (
          <p>Select Next Step to begin.</p>
        )}
      </section>
    </main>
  );
}

function MatrixView({ matrix }) {
  return (
    <table>
      <tbody>
        {matrix.map((row, i) => (
          <tr key={i}>
            {row.map((value, j) => (
              <td key={j}>
                {Number.isFinite(value) ? value : "∞"}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  );
}
