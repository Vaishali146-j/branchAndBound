Let's implement the Next Step button as the core of our TSP Branch and Bound visualizer. The important design decision is that the algorithm should produce a structured record of each operation, and the graph, search tree, cost matrix, and explanation panel should all update from that same record.
We'll use matrix-reduction Branch and Bound with a best-bound node-selection strategy.
1. What happens when the user clicks “Next Step”?
Each click advances one meaningful algorithmic action:
1. Initialize the distance matrix and calculate the root lower bound.
2. Select the eligible search-tree node with the smallest lower bound.
3. Generate a child for each valid next city.
4. Calculate each child's reduced matrix and lower bound.
5. Mark invalid or noncompetitive children as pruned, with an explanation.
6. Update the best complete tour whenever a better valid tour is found.
7. Finish when no remaining node can improve the best tour.
We should keep the algorithm independent of the UI. That way, we can test the numerical calculations separately and then synchronize all visual components reliably.
2. Implement the algorithm engine
Create a file named tspBranchBound.js. This version is framework-independent, so you can use it with React or plain JavaScript.
It supports:
* Best-bound node selection.
* Matrix row and column reduction.
* Child-node generation.
* Pruning explanations.
* Best-tour tracking.
* A nextStep() method that returns an event for the UI to render.
```
// tspBranchBound.js

const INF = Infinity;

function cloneMatrix(matrix) {
  return matrix.map((row) => [...row]);
}

function reduceMatrix(matrix) {
  const n = matrix.length;
  const reduced = cloneMatrix(matrix);
  let reductionCost = 0;
  const operations = [];

  // Reduce rows.
  for (let i = 0; i < n; i++) {
    const finite = reduced[i].filter(Number.isFinite);
    if (finite.length === 0) continue;

    const min = Math.min(...finite);

    if (min > 0) {
      for (let j = 0; j < n; j++) {
        if (Number.isFinite(reduced[i][j])) {
          reduced[i][j] -= min;
        }
      }

      reductionCost += min;
      operations.push({
        type: "row",
        index: i,
        minimum: min,
      });
    }
  }

  // Reduce columns.
  for (let j = 0; j < n; j++) {
    const finite = reduced
      .map((row) => row[j])
      .filter(Number.isFinite);

    if (finite.length === 0) continue;

    const min = Math.min(...finite);

    if (min > 0) {
      for (let i = 0; i < n; i++) {
        if (Number.isFinite(reduced[i][j])) {
          reduced[i][j] -= min;
        }
      }

      reductionCost += min;
      operations.push({
        type: "column",
        index: j,
        minimum: min,
      });
    }
  }

  return { matrix: reduced, reductionCost, operations };
}

function actualTourCost(path, distance) {
  let cost = 0;

  for (let i = 0; i < path.length - 1; i++) {
    const edge = distance[path[i]][path[i + 1]];
    if (!Number.isFinite(edge)) return INF;
    cost += edge;
  }

  const returnEdge = distance[path[path.length - 1]][path[0]];
  if (!Number.isFinite(returnEdge)) return INF;

  return cost + returnEdge;
}

export function createTspSolver(distance, start = 0) {
  const n = distance.length;

  if (n < 2 || distance.some((row) => row.length !== n)) {
    throw new Error("Provide a square distance matrix with at least 2 cities.");
  }

  if (!Number.isInteger(start) || start < 0 || start >= n) {
    throw new Error("Invalid starting city index.");
  }

  if (
    distance.some((row, i) =>
      row.some((value, j) =>
        i === j
          ? value !== INF && value !== 0
          : !(Number.isFinite(value) && value >= 0) && value !== INF
      )
    )
  ) {
    throw new Error(
      "Distances must be non-negative numbers or Infinity; diagonal entries must be 0 or Infinity."
    );
  }

  const original = cloneMatrix(distance);
  const initial = cloneMatrix(distance);

  // No self-loops.
  for (let i = 0; i < n; i++) initial[i][i] = INF;

  const rootReduction = reduceMatrix(initial);

  let nextId = 1;
  let bestTour = null;
  let bestCost = INF;
  let finished = false;

  const root = {
    id: 0,
    path: [start],
    visited: new Set([start]),
    matrix: rootReduction.matrix,
    bound: rootReduction.reductionCost,
    status: "frontier",
    parentId: null,
    edge: null,
  };

  const nodes = [root];
  const frontier = [root];

  const stats = {
    generated: 1,
    expanded: 0,
    pruned: 0,
    completeTours: 0,
  };

  function event(type, title, explanation, extra = {}) {
    return {
      type,
      title,
      explanation,
      nodes: nodes.map((node) => ({
        ...node,
        path: [...node.path],
        visited: [...node.visited],
        matrix: cloneMatrix(node.matrix),
      })),
      frontier: frontier.map((node) => node.id),
      bestTour: bestTour ? [...bestTour] : null,
      bestCost,
      stats: { ...stats },
      ...extra,
    };
  }

  function nextStep() {
    if (finished) {
      return event(
        "finished",
        "Algorithm complete",
        bestTour
          ? `No remaining node can improve the best tour of cost ${bestCost}.`
          : "No valid Hamiltonian tour exists for this graph."
      );
    }

    // Select the eligible node with the smallest lower bound.
    frontier.sort((a, b) => a.bound - b.bound || a.id - b.id);
    const current = frontier.shift();

    if (!current) {
      finished = true;
      return event(
        "finished",
        "Search exhausted",
        bestTour
          ? `The optimal tour has cost ${bestCost}.`
          : "No valid Hamiltonian tour exists."
      );
    }

    // Safe pruning: a lower bound cannot beat the incumbent.
    if (current.bound >= bestCost) {
      current.status = "pruned";
      current.reason =
        `Lower bound ${current.bound} ≥ best tour cost ${bestCost}.`;
      stats.pruned++;

      return event(
        "pruned",
        `Pruned node ${current.id}`,
        current.reason,
        { currentNodeId: current.id }
      );
    }

    current.status = "expanded";
    stats.expanded++;

    const last = current.path[current.path.length - 1];
    const children = [];
    const childEvents = [];

    for (let city = 0; city < n; city++) {
      if (current.visited.has(city)) continue;

      const reducedEdgeCost = current.matrix[last][city];

      if (!Number.isFinite(reducedEdgeCost)) {
        childEvents.push({
          city,
          status: "pruned",
          reason: `The transition ${last} → ${city} is forbidden in the reduced matrix.`,
        });
        continue;
      }

      const path = [...current.path, city];
      const visited = new Set([...current.visited, city]);
      const id = nextId++;

      // Complete tour: evaluate the real edge distances, including return.
      if (path.length === n) {
        const cost = actualTourCost(path, original);

        const child = {
          id,
          parentId: current.id,
          edge: [last, city],
          path,
          visited,
          matrix: cloneMatrix(current.matrix),
          bound: cost,
          status: Number.isFinite(cost) ? "complete" : "pruned",
          reason: null,
        };

        stats.generated++;
        nodes.push(child);

        if (!Number.isFinite(cost)) {
          child.reason = "The final city cannot return to the starting city.";
          stats.pruned++;
        } else {
          stats.completeTours++;

          if (cost < bestCost) {
            bestCost = cost;
            bestTour = [...path, start];
            child.reason = `New best tour found with total cost ${cost}.`;
          } else {
            child.reason = `Complete tour cost ${cost}; best known cost is ${bestCost}.`;
          }
        }

        children.push(id);
        childEvents.push({
          city,
          nodeId: id,
          status: child.status,
          path,
          cost,
          reason: child.reason,
        });

        continue;
      }

      // Build the child's constrained matrix.
      const childMatrix = cloneMatrix(current.matrix);

      // The chosen edge's row and column cannot be used again.
      for (let j = 0; j < n; j++) childMatrix[last][j] = INF;
      for (let i = 0; i < n; i++) childMatrix[i][city] = INF;

      // Prevent returning to the start before visiting all cities.
      childMatrix[city][start] = INF;

      const reduction = reduceMatrix(childMatrix);
      const bound =
        current.bound + reducedEdgeCost + reduction.reductionCost;

      const child = {
        id,
        parentId: current.id,
        edge: [last, city],
        path,
        visited,
        matrix: reduction.matrix,
        bound,
        status: "frontier",
        reason: null,
        reductionOperations: reduction.operations,
      };

      stats.generated++;
      nodes.push(child);
      children.push(id);

      if (bound >= bestCost) {
        child.status = "pruned";
        child.reason =
          `Lower bound ${bound} ≥ best tour cost ${bestCost}; ` +
          "this branch cannot improve the incumbent.";
        stats.pruned++;

        childEvents.push({
          city,
          nodeId: id,
          status: "pruned",
          path,
          bound,
          reductionOperations: reduction.operations,
          reason: child.reason,
        });
      } else {
        frontier.push(child);

        childEvents.push({
          city,
          nodeId: id,
          status: "frontier",
          path,
          bound,
          reductionOperations: reduction.operations,
          reason:
            `Lower bound ${bound} is below the current best cost ${bestCost}. ` +
            "Keep this node for possible expansion.",
        });
      }
    }

    if (frontier.length === 0) finished = true;

    return event(
      "expanded",
      `Expanded node ${current.id}`,
      `Expanded partial tour ${current.path.join(" → ")}. ` +
        `${children.length} child node(s) were considered. ` +
        (bestTour
          ? `Best tour cost is currently ${bestCost}.`
          : "No complete tour has been found yet."),
      {
        currentNodeId: current.id,
        childEvents,
        childNodeIds: children,
        currentMatrix: cloneMatrix(current.matrix),
        reductionOperations: current.reductionOperations ?? [],
      }
    );
  }

  function reset() {
    return createTspSolver(original, start);
  }

  return {
    nextStep,
    reset,
    getState: () =>
      event(
        "state",
        "Current algorithm state",
        "Snapshot of the search tree, frontier, statistics, and best tour."
      ),
  };
}
```
